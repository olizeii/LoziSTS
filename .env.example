# Kopieren nach .env (neben docker-compose.yml) und anpassen.

# IP-Adresse des Servers im LAN
SERVER_IP=10.0.0.210

# Port für Backend + TV-Dashboard
APP_PORT=3000

# Überschrift auf dem TV-Dashboard
EVENT_TITLE=LAN-PARTY CHALLENGE

# Passwort für das Zurücksetzen aller Daten (leer = Reset per API deaktiviert)
ADMIN_TOKEN=bitte-aendern

# Zeitzone für Logs
TZ=Europe/Berlin
