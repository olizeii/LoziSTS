# Kopieren nach .env (neben docker-compose.yml) und anpassen.

# IP-Adresse des Servers im LAN
SERVER_IP=10.0.0.210

# Port für Backend + TV-Dashboard
APP_PORT=3000

# Überschrift auf dem TV-Dashboard
EVENT_TITLE=LAN-PARTY CHALLENGE

# Passwort für das Zurücksetzen aller Daten (leer = Reset per API deaktiviert)
ADMIN_TOKEN=bitte-aendern

# Zeitzone für Logs
TZ=Europe/Berlin

# Ordner des Minecraft-Java-Servers (der Ordner mit server.properties, usercache.json und der Welt).
# Die Advancements werden daraus automatisch alle 15 Sekunden übernommen (nur lesend).
MINECRAFT_DIR=/home/oli/minecraft

# Optional: Minecraft-Version erzwingen (sonst automatisch aus logs/latest.log erkannt), z. B. 1.21.4
MINECRAFT_VERSION=
