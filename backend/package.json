{
  "name": "lan-party-tracker-backend",
  "version": "1.0.0",
  "description": "Backend für den LAN-Party Challenge Tracker (Express + Socket.io + SQLite)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/darts.test.js test/games.test.js",
    "smoke": "node scripts/smoke.js",
    "simulate": "node scripts/simulate.js",
    "reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "socket.io": "^4.8.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
