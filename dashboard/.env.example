# Kopieren nach .env und bei Bedarf anpassen.

# Nur für "npm run dev": wohin Vite /api und /socket.io weiterleitet
DEV_BACKEND_URL=http://localhost:3000
# DEV_BACKEND_URL=http://10.0.0.210:3000

# Optional: Dashboard fest mit einem Server verbinden.
# Leer lassen = verbindet sich mit dem Server, von dem das Dashboard geladen wurde (empfohlen).
# VITE_SERVER_URL=http://10.0.0.210:3000

# Überschrift oben links
VITE_EVENT_TITLE=LAN-PARTY CHALLENGE
